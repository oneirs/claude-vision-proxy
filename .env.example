# Copy this file to .env and fill in your provider settings.
VISION_BASE_URL=https://your-vision-provider.example/v2
VISION_API_KEY=replace-with-your-api-key
VISION_MODEL=your-vision-model

UPSTREAM_BASE_URL=http://127.0.0.1:15721
MODEL_MAP=
PORT=8787
VISION_CONCURRENCY=4
VISION_MAX_TOKENS=3000
VISION_TIMEOUT=120
# Optional; defaults to ~/.cache/vision-proxy/cache.json
# VISION_CACHE=
